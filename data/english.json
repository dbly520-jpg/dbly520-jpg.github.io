              { "word": "UART", "phonetic": "/ˈjuːɑːrt/", "pos": "abbr.", "meaning": "通用异步收发传输器 (Universal Asynchronous Receiver-Transmitter)", "example_en": "Use UART for serial output.", "example_cn": "用UART做串口输出。" }
